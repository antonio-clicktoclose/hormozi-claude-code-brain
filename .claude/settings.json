{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.agents/hooks/clear-writing-context.py\"",
            "statusMessage": "Loading clear-writing standard"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.agents/hooks/clear-writing-context.py\"",
            "statusMessage": "Loading clear-writing standard"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.agents/hooks/clear-writing-guard.py\"",
            "statusMessage": "Checking clear writing",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
